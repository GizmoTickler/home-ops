{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>GizmoTickler/home-ops//.renovate/autoMerge.json5",
    "github>GizmoTickler/home-ops//.renovate/changelogs.json5",
    "github>GizmoTickler/home-ops//.renovate/customManagers.json5",
    "github>GizmoTickler/home-ops//.renovate/grafanaDashboards.json5",
    "github>GizmoTickler/home-ops//.renovate/groups.json5",
    "github>GizmoTickler/home-ops//.renovate/labels.json5",
    "github>GizmoTickler/home-ops//.renovate/overrides.json5",
    "github>GizmoTickler/home-ops//.renovate/semanticCommits.json5",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/New_York)",
  ],
  registryAliases: {
    "mirror.gcr.io": "docker.io",
  },
  platformAutomerge: true,
  prConcurrentLimit: 10,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
    "cmd/**/templates/volsync/**",
    "archive/**",
    // Go test fixtures and golden files pin versions on purpose; bumping them
    // desyncs the checked-in expectations and breaks the Go test job.
    "**/testdata/**",
  ],
  packageRules: [
    {
      description: "nas01 apps (truenas/apps): a merge is deployed within 10 min by the nas01 reconciler, so only digest/patch auto-merge",
      matchFileNames: ["truenas/apps/**"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
    {
      description: "nas01 apps (truenas/apps) take free PR slots first: the nas01 reconciler deploys them on merge",
      matchFileNames: ["truenas/apps/**"],
      prPriority: 5,
    },
    {
      description: "smartctl-exporter v0.15.0 breaks on SAS drives (HTTP 500, upstream #406); nas01 is pinned to v0.14.0. Skip only v0.15.0 so a fixed release is still proposed. Remove once unpinned.",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/prometheuscommunity/smartctl-exporter"],
      allowedVersions: "!/^v?0\\.15\\.0$/",
    },
    {
      description: "Ignore unpinnable claude-code-action beta tag",
      matchManagers: [
        "github-actions"
      ],
      matchPackageNames: [
        "anthropics/claude-code-action"
      ],
      enabled: false,
    },
  ],
  flux: {
    managerFilePatterns: [
      "/\\.yaml(?:\\.j2)?$/"
    ],
  },
  "helm-values": {
    managerFilePatterns: [
      "/\\.yaml(?:\\.j2)?$/"
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      "/\\.yaml(?:\\.j2)?$/"
    ],
  },
}