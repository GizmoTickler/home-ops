{"ignition":{"version":"3.6.0"},"passwd":{"users":[{"name":"core","sshAuthorizedKeys":["ssh-ed25519 AAAATESTKEY"]}]},"storage":{"directories":[{"path":"/var/mnt/nvme-hostpath","mode":493}],"files":[{"overwrite":true,"path":"/etc/selinux/config","contents":{"compression":"","source":"data:,SELINUX%3Dpermissive%0ASELINUXTYPE%3Dtargeted%0A"},"mode":420},{"overwrite":true,"path":"/etc/NetworkManager/system-connections/30-stor1201.nmconnection","contents":{"compression":"","source":"data:;base64,W2Nvbm5lY3Rpb25dCmlkPTMwLXN0b3IxMjAxCnR5cGU9ZXRoZXJuZXQKYXV0b2Nvbm5lY3Q9dHJ1ZQpsbGRwPTAKCltldGhlcm5ldF0KbWFjLWFkZHJlc3M9QkM6MjQ6MTE6M0I6RTA6NTAKbXR1PTkwMDAKCltpcHY0XQptZXRob2Q9bWFudWFsCmFkZHJlc3MxPTE5Mi4xNjguMjAxLjIwLzI0Cm5ldmVyLWRlZmF1bHQ9dHJ1ZQoKW2lwdjZdCm1ldGhvZD1kaXNhYmxlZAo="},"mode":384},{"overwrite":true,"path":"/etc/NetworkManager/system-connections/30-stor1202.nmconnection","contents":{"compression":"","source":"data:;base64,W2Nvbm5lY3Rpb25dCmlkPTMwLXN0b3IxMjAyCnR5cGU9ZXRoZXJuZXQKYXV0b2Nvbm5lY3Q9dHJ1ZQpsbGRwPTAKCltldGhlcm5ldF0KbWFjLWFkZHJlc3M9QkM6MjQ6MTE6RUQ6RjY6QjYKbXR1PTkwMDAKCltpcHY0XQptZXRob2Q9bWFudWFsCmFkZHJlc3MxPTE5Mi4xNjguMjAyLjIwLzI0Cm5ldmVyLWRlZmF1bHQ9dHJ1ZQoKW2lwdjZdCm1ldGhvZD1kaXNhYmxlZAo="},"mode":384},{"overwrite":true,"path":"/etc/NetworkManager/system-connections/30-stor1203.nmconnection","contents":{"compression":"","source":"data:;base64,W2Nvbm5lY3Rpb25dCmlkPTMwLXN0b3IxMjAzCnR5cGU9ZXRoZXJuZXQKYXV0b2Nvbm5lY3Q9dHJ1ZQpsbGRwPTAKCltldGhlcm5ldF0KbWFjLWFkZHJlc3M9QkM6MjQ6MTE6RkY6NTA6ODEKbXR1PTkwMDAKCltpcHY0XQptZXRob2Q9bWFudWFsCmFkZHJlc3MxPTE5Mi4xNjguMjAzLjIwLzI0Cm5ldmVyLWRlZmF1bHQ9dHJ1ZQoKW2lwdjZdCm1ldGhvZD1kaXNhYmxlZAo="},"mode":384},{"overwrite":true,"path":"/etc/NetworkManager/system-connections/30-stor1204.nmconnection","contents":{"compression":"","source":"data:;base64,W2Nvbm5lY3Rpb25dCmlkPTMwLXN0b3IxMjA0CnR5cGU9ZXRoZXJuZXQKYXV0b2Nvbm5lY3Q9dHJ1ZQpsbGRwPTAKCltldGhlcm5ldF0KbWFjLWFkZHJlc3M9QkM6MjQ6MTE6RkI6MTY6NzYKbXR1PTkwMDAKCltpcHY0XQptZXRob2Q9bWFudWFsCmFkZH