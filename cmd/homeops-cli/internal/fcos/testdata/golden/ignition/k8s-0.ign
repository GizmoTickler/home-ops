0},{"overwrite":true,"path":"/etc/NetworkManager/system-connections/15-eth2-vpn.nmconnection","contents":{"compression":"","source":"data:,%5Bconnection%5D%0Aid%3D15-eth2-vpn%0Atype%3Dethernet%0Ainterface-name%3Deth2%0Aautoconnect%3Dtrue%0A%0A%5Bipv4%5D%0Amethod%3Ddisabled%0A%0A%5Bipv6%5D%0Amethod%3Ddisabled%0A"},"mode":384},{"overwrite":true,"path":"/etc/zincati/config.d/90-disable-auto-updates.toml","contents":{"compression":"","source":"data:,%5Bupdates%5D%0Aenabled%20%3D%20false%0A"},"mode":420},{"overwrite":true,"path":"/etc/systemd/zram-generator.conf","contents":{"compression":"","source":"data:,"},"mode":420},{"overwrite":true,"path":"/etc/chrony.conf","contents":{"compression":"","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/sysctl.d/99-homeops.conf","contents":{"compression":"","source":"data:,%23%20%2Fetc%2Fsysctl.d%2F99-homeops.conf%20%E2%80%94%20port%20of%20Talos%20machine.sysctls.%0A%23%2010GbE%20%2B%20jumbo-frame%20%2B%20NFS%20%2B%20namespaces%2Fhugepages%20tuning.%0A%23%20Watchdog%0Afs.inotify.max_user_watches%20%3D%201048576%0Afs.inotify.max_user_instances%20%3D%208192%0A%23%2010Gb%2Fs%0Anet.core.default_qdisc%20%3D%20fq%0A%23%20Increase%20max%20socket%20buffers%20to%20128MB%20(was%2064MB)%0Anet.core.rmem_max%20%3D%20134217728%0Anet.core.wmem_max%20%3D%20134217728%0A%23%20TCP%20buffer%20auto-tuning%20range%3A%20min%204KB%2C%20default%2C%20max%2064MB%0Anet.ipv4.tcp_rmem%20%3D%204096%2087380%2067108864%0Anet.ipv4.tcp_wmem%20%3D%204096%2065536%2067108864%0Anet.ipv4.tcp_congestion_control%20%3D%20bbr%0Anet.ipv4.tcp_fastopen%20%3D%203%0Anet.ipv4.tcp_mtu_probing%20%3D%201%0Anet.ipv4.tcp_notsent_lowat%20%3D%20131072%0Anet.ipv4.tcp_window_scaling%20%3D%201%0Anet.core.netdev_max_backlog%20%3D%2016384%0Anet.core.somaxconn%20%3D%208192%0Anet.ipv4.tcp_slow_start_after_idle%20%3D%200%0Anet.ipv4.tcp_tw_reuse%20%3D%201%0A%23%20NFS%20(sunrpc)%0Asunrpc.tcp_slot_table_entries%20%3D%20128%0Asunrpc.tcp_max_slot_table_entries%20%3D%20128%0A%23%20User%20namespaces%0Auser.max_user_namespaces%20%3D%2011255%0A%23%20HugePages%0Avm.nr_hugepages%20%3D%201024%0A%23%20Writeback%20smoothing%20for%20direct-to-NFS%20writers%20(nzbget).%20Stock%2010%25%2F20%25%20of%0A%23%20~96GB%20lets%20~9.6GB%20of%20dirty%20pages%20accumulate%20before%20writeback%20starts%2C%20which%0A%23%20produces%20a%20sawtooth%3A%20burst%20to%20page%20cache%2C%20then%20a%20multi-GB%20flush%20that%20stalls%0A%23%20the%20writer.%20Bytes-based%20thresholds%20keep%20the%20flush%20continuous.%0Avm.dirty_background_bytes%20%3D%20536870912%0Avm.dirty_bytes%20%3D%202147483648%0A%23%20NAPI%20poll%20budget%20for%2010G%2B.%20Stock%20300%2F2000us%20hit%20the%20ceiling%20repeatedly%0A%23%20(softnet%20time_squeeze%201.4k-2.4k%20per%20CPU%20with%20zero%20drops)%20--%20deferred%0A%23%20ring%20drains%20show%20up%20as%20latency%2Fjitter%2C%20not%20loss.%0Anet.core.netdev_budget%20%3D%20600%0Anet.core.netdev_budget_usecs%20%3D%208000%0A"},"mode":420},{"overwrite":true,"path":"/etc/sysctl.d/60-homeops-baselayout.conf","contents":{"compression":"","source":"data:,net.ipv4.ip_forward%20%3D%201%0Anet.ipv4.conf.default.rp_filter%20%3D%200%0Anet.ipv4.conf.all.rp_filter%20%3D%200%0Anet.ipv4.conf.*.rp_filter%20%3D%200%0A-net.ipv4.conf.all.rp_filter%0Akernel.kptr_restrict%20%3D%201%0Afs.protected_regular%20%3D%200%0Afs.protected_fifos%20%3D%200%0A"},"mode":420},{"overwrite":true,"path":"/etc/modules-load.d/homeops.conf","contents":{"compression":"","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/nfsmount.conf","contents":{"compression":"","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/containerd/config.toml","contents":{"compression":"","source":"data:,%23%20%2Fetc%2Fcontainerd%2Fconfig.toml%20%E2%80%94%20containerd%202.x%20(config%20version%203).%0A%23%20Ports%20Talos's%20%2Fetc%2Fcri%2Fconf.d%2F20-customization.part%20%2B%20adds%20kubeadm%20requirements%0A%23%20(systemd%20cgroups%2C%20pinned%20pause%20image).%20VERIFY%20plugin%20keys%2Fversion%20against%20the%20containerd%0A%23%20shipped%20by%20the%20Flatcar%20sysext%20bundle%20(2.x%20uses%20io.containerd.cri.v1.*%3B%201.x%20uses%20io.containerd.grpc.v1.cri).%0Aversion%20%3D%203%0A%0A%5Bplugins.'io.containerd.cri.v1.images'%5D%0A%20%20%23%20Talos%3A%20discard_unpacked_layers%20%3D%20false%0A%20%20discard_unpacked_layers%20%3D%20false%0A%20%20%5Bplugins.'io.containerd.cri.v1.images'.pinned_images%5D%0A%20%20%20%20sandbox%20%3D%20'registry.k8s.io%2Fpause%3A3.10.2'%0A%0A%5Bplugins.'io.containerd.cri.v1.runtime'%5D%0A%20%20%23%20Talos%3A%20device_ownership_from_security_context%20%3D%20true%0A%20%20device_ownership_from_security_context%20%3D%20true%0A%20%20%5Bplugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc%5D%0A%20%20%20%20runtime_type%20%3D%20'io.containerd.runc.v2'%0A%20%20%20%20%5Bplugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options%5D%0A%20%20%20%20%20%20%23%20kubeadm%20%2B%20kubelet%20cgroupDriver%3Dsystemd%20require%20this%20on%20the%20runtime%20side%0A%20%20%20%20%20%20SystemdCgroup%20%3D%20true%0A"},"mode":420},{"overwrite":true,"path":"/etc/kubernetes/manifests/kube-vip.yaml","contents":{"compression":"","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/kubernetes/audit/policy.yaml","contents":{"compression":"","source":"data:,%23%20kube-apiserver%20audit%20policy%20%E2%80%94%20port%20of%20Talos%20cluster.apiServer.auditPolicy.%0A%23%20Mounted%20into%20the%20apiserver%20static%20pod%20at%20%2Fetc%2Fkubernetes%2Faudit%2Fpolicy.yaml%20(see%20init-config).%0AapiVersion%3A%20audit.k8s.io%2Fv1%0Akind%3A%20Policy%0Arules%3A%0A%20%20-%20level%3A%20Metadata%0A"},"mode":420},{"overwrite":true,"path":"/etc/kubernetes/scheduler/config.yaml","contents":{"compression":"","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/usr/local/bin/homeops-install-k8s-sysext","contents":{"compression":"","source":"data:;base64,"},"mode":493},{"overwrite":true,"path":"/etc/greenboot/check/required.d/50-homeops-kubernetes.sh","contents":{"compression":"","source":"data:;base64,"},"mode":493}],"filesystems":[{"device":"/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi4","format":"ext4","label":"openebs-nvme","wipeFilesystem":false}]},"systemd":{"units":[{"contents":"[Unit]\nDescription=OpenEBS nvme-hostpath download scratch\n[Mount]\nWhat=/dev/disk/by-label/openebs-nvme\nWhere=/var/mnt/nvme-hostpath\nType=ext4\nOptions=defaults,noatime\n[Install]\nWantedBy=local-fs.target\n","enabled":true,"name":"var-mnt-nvme\\x2dhostpath.mount"},{"contents":"[Unit]\nDescription=NFS 4.1 trunk anchor via VLAN 202 (adds transports to the nas01 session)\nAfter=network-online.target\nWants=network-online.target\n[Mount]\nWhat=192.168.202.10:/mnt/flashstor/data\nWhere=/var/mnt/stor-trunk-202\nType=nfs4\n# nconnect=1 is deliberate and measured. The kernel applies nconnect to\n# the session PRIMARY only and adds exactly one transport per additional\n# trunked address, so nconnect=4 across 4 addresses gave 4:1:1:1 and\n# saturated one link while the others ran at ~36%. Measured on this\n# fabric: nconnect=1 beat nconnect=4 by +17.9% read / +22.4% write.\n# Correct ONLY because trunking supplies one address per link; against a\n# single-address server nconnect is the only parallelism knob and this\n# must go back up. max_connect must stay \u003e= the address count (kernel\n# default 1 forbids trunking outright). See files/nfsmount.conf.\nOptions=vers=4.2,ro,noatime,nconnect=1,max_connect=16\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"var-mnt-stor\\x2dtrunk\\x2d202.mount"},{"contents":"[Unit]\nDescription=NFS 4.1 trunk anchor via VLAN 203 (adds transports to the nas01 session)\nAfter=network-online.target\nWants=network-online.target\n[Mount]\nWhat=192.168.203.10:/mnt/flashstor/data\nWhere=/var/mnt/stor-trunk-203\nType=nfs4\n# nconnect=1 is deliberate and measured. The kernel applies nconnect to\n# the session PRIMARY only and adds exactly one transport per additional\n# trunked address, so nconnect=4 across 4 addresses gave 4:1:1:1 and\n# saturated one link while the others ran at ~36%. Measured on this\n# fabric: nconnect=1 beat nconnect=4 by +17.9% read / +22.4% write.\n# Correct ONLY because trunking supplies one address per link; against a\n# single-address server nconnect is the only parallelism knob and this\n# must go back up. max_connect must stay \u003e= the address count (kernel\n# default 1 forbids trunking outright). See files/nfsmount.conf.\nOptions=vers=4.2,ro,noatime,nconnect=1,max_connect=16\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"var-mnt-stor\\x2dtrunk\\x2d203.mount"},{"contents":"[Unit]\nDescription=NFS 4.1 trunk anchor via VLAN 204 (adds transports to the nas01 session)\nAfter=network-online.target\nWants=network-online.target\n[Mount]\nWhat=192.168.204.10:/mnt/flashstor/data\nWhere=/var/mnt/stor-trunk-204\nType=nfs4\n# nconnect=1 is deliberate and measured. The kernel applies nconnect to\n# the session PRIMARY only and adds exactly one transport per additional\n# trunked address, so nconnect=4 across 4 addresses gave 4:1:1:1 and\n# saturated one link while the others ran at ~36%. Measured on this\n# fabric: nconnect=1 beat nconnect=4 by +17.9% read / +22.4% write.\n# Correct ONLY because trunking supplies one address per link; against a\n# single-address server nconnect is the only parallelism knob and this\n# must go back up. max_connect must stay \u003e= the address count (kernel\n# default 1 forbids trunking outright). See files/nfsmount.conf.\nOptions=vers=4.2,ro,noatime,nconnect=1,max_connect=16\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"var-mnt-stor\\x2dtrunk\\x2d204.mount"},{"dropins":[{"contents":"[Service]\nExecStart=\nExecStart=/usr/bin/containerd --config /etc/containerd/config.toml\n","name":"10-use-config.conf"}],"enabled":true,"name":"containerd.service"},{"contents":"[Unit]\nDescription=kubelet: The Kubernetes Node Agent\nDocumentation=https://kubernetes.io/docs/\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nExecStart=/usr/bin/kubelet\nRestart=always\nStartLimitInterval=0\nRestartSec=10\n\n[Install]\nWantedBy=multi-user.target\n","dropins":[{"contents":"# Note: This dropin only works with kubeadm and kubelet v1.11+\n[Service]\nEnvironment=\"KUBELET_KUBECONFIG_ARGS=--bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf --kubeconfig=/etc/kubernetes/kubelet.conf\"\nEnvironment=\"KUBELET_CONFIG_ARGS=--config=/var/lib/kubelet/config.yaml\"\n# This is a file that \"kubeadm init\" and \"kubeadm join\" generates at runtime, populating the KUBELET_KUBEADM_ARGS variable dynamically\nEnvironmentFile=-/var/lib/kubelet/kubeadm-flags.env\n# This is a file that the user can use for overrides of the kubelet args as a last resort. Preferably, the user should use\n# the .NodeRegistration.KubeletExtraArgs object in the configuration files instead. KUBELET_EXTRA_ARGS should be sourced from this file.\nEnvironmentFile=-/etc/sysconfig/kubelet\nExecStart=\nExecStart=/usr/bin/kubelet $KUBELET_KUBECONFIG_ARGS $KUBELET_CONFIG_ARGS $KUBELET_KUBEADM_ARGS $KUBELET_EXTRA_ARGS\n","name":"10-kubeadm.conf"},{"contents":"[Unit]\nAfter=install-k8s-sysext.service systemd-sysext.service\n[Service]\nExecStartPre=/usr/bin/mkdir -p /opt/cni/bin\nExecStartPre=/usr/bin/cp -r /usr/libexec/cni/. /opt/cni/bin/\nExecStartPre=/usr/bin/cp /usr/share/kubernetes/kubernetes-version /etc/kubernetes-version\nExecStartPre=/usr/bin/mkdir -p /var/kubernetes/kubelet-plugins/volume/exec/\n","name":"20-homeops-fcos.conf"}],"enabled":true,"name":"kubelet.service"},{"dropins":[{"contents":"[Unit]\nUpholds=kubelet.service\n","name":"10-kubelet-service.conf"}],"name":"multi-user.target"},{"mask":true,"name":"docker.service"},{"mask":true,"name":"docker.socket"},{"enabled":true,"name":"systemd-sysext.service"},{"contents":"[Unit]\nDescription=Layer greenboot (boot health checks + rollback) and reboot once (first boot)\nWants=network-online.target\nAfter=network-online.target nss-lookup.target\nBefore=install-k8s-sysext.service kubelet.service\nConditionPathExists=!/var/lib/homeops/greenboot-layered\nConditionPathExists=!/etc/kubernetes/kubelet.conf\n[Service]\nType=oneshot\nRemainAfterExit=yes\n# qemu-guest-agent rides the same layering: Proxmox uses it for clean\n# shutdown and IP discovery, as on the Flatcar nodes (not in the FCOS base).\nExecStart=/usr/bin/rpm-ostree install --idempotent --allow-inactive greenboot greenboot-default-health-checks qemu-guest-agent\nExecStart=/usr/bin/mkdir -p /var/lib/homeops\nExecStart=/usr/bin/touch /var/lib/homeops/greenboot-layered\nExecStart=/usr/bin/systemctl --no-block reboot\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"homeops-layer-greenboot.service"},{"contents":"[Unit]\nDescription=Enable the layered greenboot units (once, after the layering reboot)\nConditionPathExists=/usr/libexec/greenboot/greenboot\nConditionPathExists=!/var/lib/homeops/greenboot-enabled\n[Service]\nType=oneshot\nRemainAfterExit=yes\n# greenboot 0.16 (Fedora 44) ships two units: the health check and the\n# rollback trigger. The older task-runner/grub2/redboot units are gone.\nExecStart=/usr/bin/systemctl enable --now greenboot-healthcheck.service greenboot-set-rollback-trigger.service\nExecStart=/usr/bin/systemctl enable --now qemu-guest-agent.service\nExecStart=/usr/bin/touch /var/lib/homeops/greenboot-enabled\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"homeops-enable-greenboot.service"},{"contents":"[Unit]\nDescription=Build + activate the Kubernetes directory sysext (first boot)\nWants=network-online.target\nRequires=homeops-layer-greenboot.service\nAfter=network-online.target nss-lookup.target homeops-layer-greenboot.service\nConditionPathExists=!/var/lib/homeops/k8s-sysext-v1.36.1.stamp\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/local/bin/homeops-install-k8s-sysext\nExecStart=/usr/bin/systemctl daemon-reload\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"install-k8s-sysext.service"}]}}