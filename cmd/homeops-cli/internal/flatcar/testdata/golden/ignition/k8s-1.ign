5rXQpOYW1lPWV0aDEK"},"mode":420},{"overwrite":true,"path":"/etc/systemd/network/15-eth1-iot.network","contents":{"compression":"","source":"data:,%5BMatch%5D%0AName%3Deth1%0A%5BLink%5D%0ARequiredForOnline%3Dno%0A%5BNetwork%5D%0ADHCP%3Dno%0ALinkLocalAddressing%3Dno%0AIPv6AcceptRA%3Dno%0AConfigureWithoutCarrier%3Dyes%0A"},"mode":420},{"overwrite":true,"path":"/etc/systemd/network/10-eth2.link","contents":{"compression":"","source":"data:;base64,W01hdGNoXQpNQUNBZGRyZXNzPWJjOjI0OjExOjMzOjRjOjM3CltMaW5rXQpOYW1lPWV0aDIK"},"mode":420},{"overwrite":true,"path":"/etc/systemd/network/15-eth2-vpn.network","contents":{"compression":"","source":"data:,%5BMatch%5D%0AName%3Deth2%0A%5BLink%5D%0ARequiredForOnline%3Dno%0A%5BNetwork%5D%0ADHCP%3Dno%0ALinkLocalAddressing%3Dno%0AIPv6AcceptRA%3Dno%0AConfigureWithoutCarrier%3Dyes%0A"},"mode":420},{"overwrite":true,"path":"/etc/flatcar/update.conf","contents":{"compression":"","source":"data:,GROUP%3Dstable%0ASERVER%3Ddisabled%0A"},"mode":420},{"overwrite":true,"path":"/etc/systemd/timesyncd.conf","contents":{"compression":"gzip","source":"data:;base64,H4sIAAAAAAAC/4oOycxNjeXyCwmwNTTQMzQyhmEFFK4JKtcUlWuGyjXnAgQAAP//3psbI1YAAAA="},"mode":420},{"overwrite":true,"path":"/etc/sysctl.d/99-homeops.conf","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/modules-load.d/homeops.conf","contents":{"compression":"gzip","source":"data:;base64,H4sIAAAAAAAC/1zMMW7FIBAE0J5TjEQNPkSkSK5+iiSthZe1QcYsAuy0OUROmJNEiuzmTzXFm9EYuNOwiz8SN5PEeeuHIDtLaZYkL/j9/kGR2iEL3l2Sht1RiJntxjVzstfYKo08e1wxyNy/pG6Yk9AGz2ckVhrnEsUUiv/m83V8oLjWeqhyrEFpHFGmQnFaOXONBIO7fYwPvL2MKs9e3S/qiau/AAAA///bXewy0gAAAA=="},"mode":420},{"overwrite":true,"path":"/etc/nfsmount.conf","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/containerd/config.toml","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/kubernetes/manifests/kube-vip.yaml","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/etc/kubernetes/audit/policy.yaml","contents":{"compression":"gzip","source":"data:;base64,H4sIAAAAAAAC/0SOQUoEMRBF9znFh9noYhLcSd9hQFDcl0mNFh1TIVVpmJ2H8ISeROxeuP//vXfCOt/4TF2Mx8YDNIs4ulbJN/x8faPrcOgVL1TVkOs05xGpy/N+iPvhad/HcMJFZ3MukOYK/2D8o83JJaNrATkSe05/8tHY2dLOSYc43uiz4s6YIU38nLVd5f0+BuryysNE23KUxvXRomjaHsIqrSw4SsKYlW0JwBmVN64LLuxUyCn8BgAA//+4dvAh8wAAAA=="},"mode":420},{"overwrite":true,"path":"/etc/kubernetes/scheduler/config.yaml","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420}],"filesystems":[{"device":"/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi4","format":"ext4","label":"openebs-nvme","wipeFilesystem":false}],"links":[{"overwrite":true,"path":"/etc/extensions/kubernetes.raw","hard":false,"target":"/opt/extensions/kubernetes/kubernetes-v1.36.1-x86-64.raw"}]},"systemd":{"units":[{"contents":"[Unit]\nDescription=OpenEBS nvme-hostpath download scratch\n[Mount]\nWhat=/dev/disk/by-label/openebs-nvme\nWhere=/var/mnt/nvme-hostpath\nType=ext4\nOptions=defaults,noatime\n[Install]\nWantedBy=local-fs.target\n","enabled":true,"name":"var-mnt-nvme\\x2dhostpath.mount"},{"contents":"[Unit]\nDescription=NFS 4.1 trunk anchor via VLAN 201 (adds transports to the nas01 session)\nAfter=network-online.target\nWants=network-online.target\n[Mount]\nWhat=192.168.201.10:/mnt/flashstor/data\nWhere=/var/mnt/stor-trunk-201\nType=nfs4\n# nconnect=1 is deliberate. The kernel applies nconnect to the session\n# PRIMARY only and adds exactly one transport per additional trunked\n# address, so nconnect\u003e1 always overloads the primary link (4:1:1:1 on\n# the old four-link fabric, 2:1 on today's two). nconnect=1 beat\n# nconnect=4 by +17.9% read / +22.4% write on four links; not yet\n# re-measured on two. Correct ONLY because trunking supplies one\n# address per link; against a single-address server nconnect is the\n# only parallelism knob and this must go back up. max_connect must stay\n# \u003e= the address count (kernel default 1 forbids trunking outright).\n# Every anchor's address must be live: a dead one adds a transport that\n# never answers and hangs the whole shared session (2026-10-16, .203/.204).\n# See files/nfsmount.conf.\nOptions=vers=4.2,ro,noatime,nconnect=1,max_connect=16\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"var-mnt-stor\\x2dtrunk\\x2d201.mount"},{"contents":"[Unit]\nDescription=NFS 4.1 trunk anchor via VLAN 202 (adds transports to the nas01 session)\nAfter=network-online.target\nWants=network-online.target\n[Mount]\nWhat=192.168.202.10:/mnt/flashstor/data\nWhere=/var/mnt/stor-trunk-202\nType=nfs4\n# nconnect=1 is deliberate. The kernel applies nconnect to the session\n# PRIMARY only and adds exactly one transport per additional trunked\n# address, so nconnect\u003e1 always overloads the primary link (4:1:1:1 on\n# the old four-link fabric, 2:1 on today's two). nconnect=1 beat\n# nconnect=4 by +17.9% read / +22.4% write on four links; not yet\n# re-measured on two. Correct ONLY because trunking supplies one\n# address per link; against a single-address server nconnect is the\n# only parallelism knob and this must go back up. max_connect must stay\n# \u003e= the address count (kernel default 1 forbids trunking outright).\n# Every anchor's address must be live: a dead one adds a transport that\n# never answers and hangs the whole shared session (2026-10-16, .203/.204).\n# See files/nfsmount.conf.\nOptions=vers=4.2,ro,noatime,nconnect=1,max_connect=16\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"var-mnt-stor\\x2dtrunk\\x2d202.mount"},{"dropins":[{"contents":"[Service]\nExecStart=\nExecStart=/usr/bin/containerd --config /etc/containerd/config.toml\n","name":"10-use-config.conf"}],"enabled":true,"name":"containerd.service"},{"enabled":true,"name":"kubelet.service"},{"mask":true,"name":"docker.service"},{"mask":true,"name":"locksmithd.service"},{"contents":"[Unit]\nDescription=Download + activate Kubernetes systemd-sysext (first boot)\nAfter=network-online.target nss-lookup.target\nWants=network-online.target\nConditionPathExists=!/opt/extensions/kubernetes/kubernetes-v1.36.1-x86-64.raw\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStartPre=/usr/bin/mkdir -p /opt/extensions/kubernetes /etc/sysupdate.kubernetes.d /etc/sysupdate.d\nExecStart=/usr/bin/curl --fail --location --retry 6 --retry-delay 5 --retry-connrefused -o /opt/extensions/kubernetes/kubernetes-v1.36.1-x86-64.raw https://extensions.flatcar.org/extensions/kubernetes/kubernetes-v1.36.1-x86-64.raw\nExecStart=/usr/bin/curl --fail --location --retry 6 --retry-delay 5 -o /etc/sysupdate.kubernetes.d/kubernetes-v1.36.conf https://extensions.flatcar.org/extensions/kubernetes/kubernetes-v1.36.conf\nExecStart=/usr/bin/curl --fail --location --retry 6 --retry-delay 5 -o /etc/sysupdate.d/noop.conf https://extensions.flatcar.org/extensions/noop.conf\nExecStart=/usr/bin/systemd-sysext refresh\nExecStart=/usr/bin/systemctl daemon-reload\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"install-k8s-sysext.service"},{"enabled":true,"name":"systemd-sysext.service"},{"enabled":true,"name":"systemd-sysupdate.timer"},{"dropins":[{"contents":"[Service]\nExecStartPre=/usr/bin/sh -c 'readlink --canonicalize /etc/extensions/kubernetes.raw \u003e /tmp/kubernetes'\nExecStartPre=/usr/lib/systemd/systemd-sysupdate -C kubernetes update\nExecStartPost=/usr/bin/sh -c 'readlink --canonicalize /etc/extensions/kubernetes.raw \u003e /tmp/kubernetes-new; if ! cmp --silent /tmp/kubernetes /tmp/kubernetes-new; then touch /run/reboot-required; fi'\n","name":"kubernetes.conf"}],"name":"systemd-sysupdate.service"},{"mask":true,"name":"systemd-sysupdate-reboot.timer"},{"mask":true,"name":"systemd-sysupdate-reboot.service"}]}}