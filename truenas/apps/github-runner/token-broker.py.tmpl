#!/usr/bin/env python3
"""Ephemeral GitHub Actions JIT runner config broker over a Unix domain socket.

Keeps the GitHub App private key and scoped installation token isolated inside
the token-broker container (uid 65532). Runners (uid 1001) request single-use
JIT configs via POST /jitconfig?slot=<1..4> over /broker/broker.sock.
"""
import base64
import json
import os
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer

OWNER = "GizmoTickler"
REPO = "infrastructure-automation"
RUNNER_LABEL = "ia-automation"
PEM_PATH = "/config/github-app.pem"
SOCK_PATH = "/broker/broker.sock"

APP_ID = os.environ["GITHUB_APP_ID"].strip()
INSTALLATION_ID = os.environ["GITHUB_INSTALLATION_ID"].strip()

_LOCK = threading.Lock()
_TOKEN = None
_TOKEN_EXP = 0.0


def _b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


def _app_jwt() -> str:
    now = int(time.time())
    hdr = _b64url(json.dumps({"alg": "RS256", "typ": "JWT"}, separators=(",", ":")).encode())
    pay = _b64url(json.dumps({"iat": now - 30, "exp": now + 300, "iss": APP_ID}, separators=(",", ":")).encode())
    signing_input = f"{hdr}.{pay}".encode("ascii")
    sig = subprocess.run(
        ["openssl", "dgst", "-sha256", "-sign", PEM_PATH],
        input=signing_input,
        check=True,
        capture_output=True,
    ).stdout
    return f"{hdr}.{pay}.{_b64url(sig)}"


def _gh_api(method: str, path: str, token: str, body=None):
    url = f"https://api.github.com{path}"
    data = None if body is None else json.dumps(body).encode("utf-8")
    headers = {
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "nas01-github-runner-broker",
    }
    if data is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    with urllib.request.urlopen(req, timeout=20) as resp:
        raw = resp.read()
        return resp.status, (json.loads(raw) if raw else {})


def _installation_token() -> str:
    global _TOKEN, _TOKEN_EXP
    now = time.time()
    if _TOKEN and now < _TOKEN_EXP:
        return _TOKEN
    _, data = _gh_api(
        "POST",
        f"/app/installations/{INSTALLATION_ID}/access_tokens",
        _app_jwt(),
        body={"repositories": [REPO], "permissions": {"administration": "write"}},
    )
    _TOKEN = data["token"]
    _TOKEN_EXP = now + 2400.0
    return _TOKEN


def _cleanup_offline_slot(token: str, slot: str) -> None:
    prefix = f"ia-nas01-{slot}-"
    _, data = _gh_api("GET", f"/repos/{OWNER}/{REPO}/actions/runners?per_page=100", token)
    for r in data.get("runners", []):
        if str(r.get("name", "")).startswith(prefix) and r.get("status") == "offline" and not r.get("busy"):
            try:
                _gh_api("DELETE", f"/repos/{OWNER}/{REPO}/actions/runners/{r['id']}", token)
            except urllib.error.HTTPError as e:
                if e.code != 404:
                    print(f"warn: cleanup runner {r.get('name')} HTTP {e.code}", file=sys.stderr, flush=True)


def _mint_jitconfig(slot: str) -> str:
    with _LOCK:
        token = _installation_token()
        try:
            _cleanup_offline_slot(token, slot)
        except Exception as e:
            print(f"warn: cleanup slot {slot}: {type(e).__name__}", file=sys.stderr, flush=True)
        name = f"ia-nas01-{slot}-{int(time.time())}"
        _, data = _gh_api(
            "POST",
            f"/repos/{OWNER}/{REPO}/actions/runners/generate-jitconfig",
            token,
            body={
                "name": name,
                "runner_group_id": 1,
                "labels": [RUNNER_LABEL],
                "work_folder": "_work",
            },
        )
        print(f"minted ephemeral jitconfig for {name}", flush=True)
        return data["encoded_jit_config"]


class _UnixHandler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def address_string(self):
        return "unix-client"

    def _safe_error(self, code, message=None):
        try:
            self.send_error(code, message)
        except BrokenPipeError:
            pass

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/jitconfig":
            self._safe_error(404)
            return
        qs = urllib.parse.parse_qs(parsed.query)
        slot = (qs.get("slot") or [""])[0]
        if slot not in ("1", "2", "3", "4"):
            self._safe_error(400, "invalid slot")
            return
        try:
            jit = _mint_jitconfig(slot)
        except urllib.error.HTTPError as e:
            print(f"error: github api HTTP {e.code} for slot {slot}: {e.reason}", file=sys.stderr, flush=True)
            self._safe_error(502, f"github HTTP {e.code}")
            return
        except Exception as e:
            print(f"error: mint failed for slot {slot}: {type(e).__name__}", file=sys.stderr, flush=True)
            self._safe_error(500, "mint error")
            return
        payload = json.dumps({"encoded_jit_config": jit}).encode("utf-8")
        try:
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        except BrokenPipeError:
            pass


class _UnixHTTPServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


class _HealthHandler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def do_GET(self):
        if self.path == "/healthz":
            self.send_response(200)
            self.send_header("Content-Length", "2")
            self.end_headers()
            self.wfile.write(b"ok")
        else:
            self.send_error(404)


def main():
    os.makedirs(os.path.dirname(SOCK_PATH), exist_ok=True)
    if os.path.exists(SOCK_PATH):
        os.unlink(SOCK_PATH)
    health = HTTPServer(("127.0.0.1", 8080), _HealthHandler)
    threading.Thread(target=health.serve_forever, daemon=True).start()
    srv = _UnixHTTPServer(SOCK_PATH, _UnixHandler)
    os.chmod(SOCK_PATH, 0o660)
    print(f"token-broker listening on {SOCK_PATH} and 127.0.0.1:8080", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
