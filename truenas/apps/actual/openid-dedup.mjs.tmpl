// Idempotent /openid/callback wrapper for actual-server (loaded via NODE_OPTIONS=--import).
// Safari can send duplicate GET /openid/callback?code=...&state=... navigations ~35ms apart
// across cross-origin OIDC redirects / COOP browsing-context-group switches. Because Pocket ID
// authorization codes are single-use, actual-server's second token exchange fails with
// {"status":"error","reason":"openid-grant-failed"} unless in-flight and recently redeemed
// (state, code) pairs coalesce and replay the 302 redirect to /openid-cb?token=... .
import http from 'node:http';

const TTL_MS = 60_000;
const INFLIGHT_TIMEOUT_MS = 15_000;
const MAX_ENTRIES = 256;
const cache = new Map(); // `${state}:${code}` -> { ts, inflight, location, waiters }

function prune(now) {
  for (const [k, v] of cache) {
    if (now - v.ts > TTL_MS && !v.inflight) cache.delete(k);
  }
  while (cache.size >= MAX_ENTRIES) {
    const oldest = cache.keys().next().value;
    if (oldest === undefined) break;
    cache.delete(oldest);
  }
}

function setIsolationHeaders(res) {
  if (!res.headersSent) {
    res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
    res.setHeader('Cross-Origin-Embedder-Policy', 'require-corp');
    res.setHeader('Cache-Control', 'no-store');
  }
}

function sendRedirect(res, location) {
  if (res.writableEnded) return;
  if (!res.headersSent) {
    res.writeHead(302, {
      Location: location,
      'Cache-Control': 'no-store',
      'Cross-Origin-Opener-Policy': 'same-origin',
      'Cross-Origin-Embedder-Policy': 'require-corp',
    });
  }
  res.end();
}

function sendGrantError(res) {
  if (res.writableEnded) return;
  const body = JSON.stringify({ status: 'error', reason: 'openid-grant-failed' });
  if (!res.headersSent) {
    res.writeHead(400, {
      'Content-Type': 'application/json; charset=utf-8',
      'Cache-Control': 'no-store',
      'Cross-Origin-Opener-Policy': 'same-origin',
      'Cross-Origin-Embedder-Policy': 'require-corp',
    });
  }
  res.end(body);
}

const origEmit = http.Server.prototype.emit;
http.Server.prototype.emit = function patchedEmit(event, req, res, ...rest) {
  if (
    event === 'request' &&
    req &&
    res &&
    req.method === 'GET' &&
    typeof req.url === 'string' &&
    req.url.startsWith('/openid/callback')
  ) {
    setIsolationHeaders(res);
    let parsed = null;
    try {
      parsed = new URL(req.url, 'http://localhost');
    } catch {
      parsed = null;
    }
    if (parsed && parsed.pathname === '/openid/callback') {
      const code = parsed.searchParams.get('code');
      const state = parsed.searchParams.get('state');
      if (code && state) {
        const now = Date.now();
        prune(now);
        const key = `${state}:${code}`;
        const existing = cache.get(key);
        if (existing) {
          if (existing.location) {
            console.log('[openid-dedup] replaying cached 302 for duplicate /openid/callback');
            sendRedirect(res, existing.location);
            return true;
          }
          if (existing.inflight) {
            console.log('[openid-dedup] coalescing concurrent /openid/callback');
            const waiter = {
              res,
              timer: setTimeout(() => {
                const idx = existing.waiters.indexOf(waiter);
                if (idx !== -1) existing.waiters.splice(idx, 1);
                sendGrantError(res);
              }, INFLIGHT_TIMEOUT_MS),
            };
            waiter.timer.unref?.();
            existing.waiters.push(waiter);
            return true;
          }
        }

        const entry = { ts: now, inflight: true, location: null, waiters: [] };
        cache.set(key, entry);

        const cleanupTimer = setTimeout(() => {
          if (entry.inflight) {
            entry.inflight = false;
            cache.delete(key);
            for (const w of entry.waiters.splice(0)) {
              clearTimeout(w.timer);
              sendGrantError(w.res);
            }
          }
        }, INFLIGHT_TIMEOUT_MS + 5_000);
        cleanupTimer.unref?.();

        let capturedLocation = null;
        const origWriteHead = res.writeHead;
        res.writeHead = function patchedWriteHead(statusCode, statusMessage, headers) {
          const hdrs =
            typeof statusMessage === 'object' && statusMessage !== null ? statusMessage : headers;
          if (hdrs && !Array.isArray(hdrs)) {
            for (const [hk, hv] of Object.entries(hdrs)) {
              if (hk.toLowerCase() === 'location' && typeof hv === 'string') {
                capturedLocation = hv;
              }
            }
          }
          return origWriteHead.apply(this, arguments);
        };

        let settled = false;
        const origEnd = res.end;
        res.end = function patchedEnd(...endArgs) {
          if (!settled) {
            settled = true;
            clearTimeout(cleanupTimer);
            const loc = res.getHeader('location') || capturedLocation;
            if (
              res.statusCode >= 300 &&
              res.statusCode < 400 &&
              typeof loc === 'string' &&
              loc.length > 0
            ) {
              entry.inflight = false;
              entry.location = loc;
              entry.ts = Date.now();
              for (const w of entry.waiters.splice(0)) {
                clearTimeout(w.timer);
                console.log('[openid-dedup] replaying coalesced 302 for concurrent /openid/callback');
                sendRedirect(w.res, loc);
              }
            } else {
              entry.inflight = false;
              cache.delete(key);
              for (const w of entry.waiters.splice(0)) {
                clearTimeout(w.timer);
                sendGrantError(w.res);
              }
            }
          }
          return origEnd.apply(this, endArgs);
        };
      }
    }
  }
  return origEmit.call(this, event, req, res, ...rest);
};
