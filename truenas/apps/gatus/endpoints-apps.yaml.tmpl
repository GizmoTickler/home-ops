# Gatus endpoints for the web apps (truenas/apps/gatus). Rendered by the reconciler.
#
# Every app is checked through Envoy, the same path users take (Gatus is on the `monitoring` network only).
# Apps without Envoy's OAuth2 filter: expect the app's own answer (tests DNS + Envoy + the app).
# Apps behind Envoy's Pocket ID OAuth2 filter (bazarr, chaptarr, it-tools, nzbget, pinchflat, prowlarr, qbittorrent,
# radarr, seerr, sonarr): the filter answers unauthenticated requests itself with a 302 to Pocket ID, so the check
# (redirects not followed, expect 302) proves the Envoy route and filter are live but NOT that the app behind it is
# up. Backend health for those needs an Envoy-side change (active health checks or an unauthenticated health path).
endpoints:
  - name: Actual
    group: Apps
    url: https://actual.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    interval: 1m
    conditions:
    - "[STATUS] == 200"
  - name: Atuin
    group: Apps
    url: https://atuin.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    interval: 1m
    conditions:
    - "[STATUS] == 200"
