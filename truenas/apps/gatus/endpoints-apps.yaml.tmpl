# Gatus endpoints for the web apps (truenas/apps/gatus). Frozen from what the k8s gatus-sidecar generated from the
# HTTPRoutes on 2026-11-12 (k8s-only flux-web/kopia/echo/github-webhook/logs dropped). Rendered by the reconciler.
endpoints:
- name: actual
  group: internal
  url: https://actual.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
  conditions:
  - '[STATUS] == 200'
  interval: 1m0s
- name: atuin
  group: internal
  url: https://atuin.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
  conditions:
  - '[STATUS] == 200'
  interval: 1m0s
