  # ---- Monitoring stack (alerted on by up-based rules, so not by GatusEndpointDown). ----
  - name: Grafana
    group: Monitoring
    url: https://grafana.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/api/health
    interval: 1m
    conditions:
    - "[STATUS] == 200"
  - name: Alertmanager
    group: Monitoring
    url: http://alertmanager:9093/-/healthy
    interval: 1m
    conditions:
    - "[STATUS] == 200"
  - name: VictoriaMetrics
    group: Monitoring
    url: http://victoria-metrics:8428/health
    interval: 1m
    conditions:
    - "[STATUS] == 200"
  - name: vmalert
    group: Monitoring
    url: http://vmalert:8880/health
    interval: 1m
    conditions:
    - "[STATUS] == 200"
  - name: kromgo (badges)
    group: Monitoring
    url: https://kromgo.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/
    interval: 1m
    conditions:
    - "[STATUS] == 200"

  # ---- External: the public path (Cloudflare -> cloudflared tunnel -> Envoy external -> app). Resolved through
  # public DNS so the check does not take the internal shortcut to Envoy. ----
  - name: n8n webhooks (via Cloudflare)
    group: External
    url: https://n8n-webhook.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/webhook
    client:
      dns-resolver: tcp://1.1.1.1:53
    interval: 1m
    conditions:
    - "[STATUS] == 200"
