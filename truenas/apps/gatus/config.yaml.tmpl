# Gatus main config (truenas/apps/gatus). Rendered by the reconciler. Web-app checks are in endpoints-apps.yaml.
#
# Alerting: Gatus has NO alerting provider on purpose. vmalert alerts on Gatus' metrics (GatusEndpointDown in
# truenas/apps/vmalert) and routes through Alertmanager -> Pushover, so there is one notification path.
# GatusEndpointDown covers the groups Apps and Management; Internet, Network and Monitoring are covered by
# blackbox/up-based rules (InternetUnreachable, BlackboxProbeFailed, BackupGatewayDown, DNS*, VM*Down, TargetDown)
# and are not alerted on twice.
#
# Groups: Internet (WAN reachability) | Network (edge, core, backup WAN, DNS) | Management (TrueNAS, Proxmox, UniFi,
# 1Password Connect) | Monitoring | Apps.
# Probes leave nas01 as 192.168.123.157 = SGT 25 (monitoring); a check that times out on a live device is usually
# SC01 TrustSec (cells from 25 in infrastructure-automation trustsec.yml).
# Gatus skips all checks while this target is unreachable (nas01 itself offline). The DNS VIP survives the loss of
# either DNS server, so one DNS VM going down does not blank the whole page.
connectivity:
  checker:
    target: 192.168.123.249:53
    interval: 1m

metrics: true

security:
  oidc:
    issuer-url: https://id.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    redirect-url: https://status.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/authorization-code/callback
    client-id: "{{ op://Infrastructure/gatus/OIDC_CLIENT_ID }}"
    client-secret: "{{ op://Infrastructure/gatus/OIDC_CLIENT_SECRET }}"
    scopes:
      - openid
      - email
      - profile

ui:
  title: Status | Gatus
  header: Status
  logo: https://avatars.githubusercontent.com/u/19583593
  link: https://github.com/GizmoTickler/home-ops
  buttons:
    - name: Github
      link: https://github.com/GizmoTickler
    - name: homelab
      link: https://github.com/GizmoTickler/home-ops

web:
  port: 80

endpoints:
  # ---- Internet: can nas01 reach the internet (fiber, or cellular after failover)? ----
  - name: Cloudflare DNS (1.1.1.1)
    group: Internet
    url: icmp://1.1.1.1
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Google DNS (8.8.8.8)
    group: Internet
    url: icmp://8.8.8.8
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Quad9 (9.9.9.9)
    group: Internet
    url: icmp://9.9.9.9
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Cisco Umbrella (208.67.220.220)
    group: Internet
    url: icmp://208.67.220.220
    interval: 1m
    conditions:
      - "[CONNECTED] == true"

  # ---- Network: the routers/switch and DNS. ----
  - name: Internet edge (UXG-Fiber)
    group: Network
    url: icmp://10.255.255.46
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Core switch (SC01)
    group: Network
    url: icmp://10.255.255.253
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Cellular router (Route10)
    group: Network
    url: icmp://10.255.255.50
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Alta Control
    group: Network
    url: icmp://192.168.120.17
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: DNS (VIP)
    group: Network
    url: 192.168.123.249
    dns:
      query-name: nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
      query-type: A
    interval: 1m
    conditions:
      - "[DNS_RCODE] == NOERROR"
  - name: DNS (dns0)
    group: Network
    url: 192.168.123.250
    dns:
      query-name: nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
      query-type: A
    interval: 1m
    conditions:
      - "[DNS_RCODE] == NOERROR"
  - name: DNS (dns1)
    group: Network
    url: 192.168.123.251
    dns:
      query-name: nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
      query-type: A
    interval: 1m
    conditions:
      - "[DNS_RCODE] == NOERROR"
  - name: DNS (anycast 10.53.53.53)
    group: Network
    url: 10.53.53.53
    dns:
      query-name: nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
      query-type: A
    interval: 1m
    conditions:
      - "[DNS_RCODE] == NOERROR"

  # ---- Management UIs. ----
  - name: TrueNAS (nas01)
    group: Management
    url: https://nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    interval: 1m
    conditions:
      - "[STATUS] == 200"
  - name: Proxmox (pve)
    group: Management
    url: https://pve.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:8006
    interval: 1m
    conditions:
      - "[STATUS] == 200"
  - name: UniFi controller
    group: Management
    url: https://unifi.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    interval: 1m
    conditions:
      - "[STATUS] == 200"
  - name: 1Password Connect
    group: Management
    url: https://passwords.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/heartbeat
    interval: 1m
    conditions:
      - "[STATUS] == 200"
