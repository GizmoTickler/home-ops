# NZBGet configuration for the nas01 TrueNAS app (moved from k8s 2026-11-11).
# Rendered by truenas/apps/deploy-nzbget.sh with secrets from 1Password item 'nzbget'.
# Settings changed in the web UI do NOT survive a redeploy: change them here.
# Difference from the k8s template: the control user now has a password; only cluster pods
# (k8s nodes 192.168.122.10-12: Cilium masquerades pod egress, so the Pocket ID gateway and
# *arr apps arrive from node IPs) and Caddy on nas01 (172.31.200.2, behind Pocket ID) are exempt via AuthorizedIP.
# NZBGet configuration — deployed via Flux/GitOps
# This template is copied to /config/nzbget.conf on first run only.
# Runtime changes via the web UI are preserved.

# Paths
MainDir=/downloads
TempDir=/tmp/nzbget
InterDir=/incomplete
DestDir=/media/usenet
QueueDir=/config/queue
NzbDir=/config/nzb
ScriptDir=/config/scripts
WebDir=/app/nzbget/webui
ConfigTemplate=/app/nzbget/share/nzbget/nzbget.conf
LockFile=/config/nzbget.lock
LogFile=/config/nzbget.log

# Server Control
ControlPort=6789
ControlUsername=nzbget
ControlPassword={{ op://Infrastructure/nzbget/CONTROL_PASS }}
AuthorizedIP=172.31.200.2
RestrictedUsername={{ op://Infrastructure/nzbget/RESTRICTED_USER }}
RestrictedPassword={{ op://Infrastructure/nzbget/RESTRICTED_PASS }}
DaemonUsername=root

# Performance — Download
ArticleCache=12000
DirectWrite=yes
DirectRename=yes
DirectUnpack=yes
WriteBuffer=4096
CrcCheck=no
FlushQueue=no
ContinuePartial=no
RawArticle=no
ArticleRetries=3
ArticleInterval=5
ArticleTimeout=30
UrlConnections=4
FileNaming=auto
ReorderFiles=yes
SkipWrite=no
PropagationDelay=0

# Performance — v26 features
HardLinking=no
SystemHealthCheck=no
PostStrategy=aggressive

# Par/Repair
ParCheck=auto
ParQuick=yes
ParBuffer=1024
ParThreads=16
ParPauseQueue=no
ParRename=yes
RarRename=yes
ParScan=extended
ParRepair=yes
HealthCheck=park

# Unpack
Unpack=yes
UnpackPauseQueue=yes
UnpackCleanupDisk=yes

# Logging (minimal for performance)
InfoTarget=screen
WarningTarget=screen
ErrorTarget=both
DebugTarget=none
DetailTarget=none
WriteLog=rotate
RotateLog=3

# Server 1 (primary)
Server1.Active=yes
Server1.Name={{ op://Infrastructure/nzbget/SERVER1_NAME }}
Server1.Host={{ op://Infrastructure/nzbget/SERVER1_HOST }}
Server1.Port=563
Server1.Encryption=yes
Server1.Connections=50
Server1.Username={{ op://Infrastructure/nzbget/SERVER1_USER }}
Server1.Password={{ op://Infrastructure/nzbget/SERVER1_PASS }}
Server1.Level=0
Server1.Group=0
Server1.Cipher=TLS_AES_128_GCM_SHA256

# Server 2 (primary)
Server2.Active=yes
Server2.Name={{ op://Infrastructure/nzbget/SERVER2_NAME }}
Server2.Host={{ op://Infrastructure/nzbget/SERVER2_HOST }}
Server2.Port=563
Server2.Encryption=yes
Server2.Connections=50
Server2.Username={{ op://Infrastructure/nzbget/SERVER2_USER }}
Server2.Password={{ op://Infrastructure/nzbget/SERVER2_PASS }}
Server2.Level=0
Server2.Group=1
Server2.Cipher=TLS_AES_128_GCM_SHA256

# Server 3 (fill)
Server3.Active=yes
Server3.Name={{ op://Infrastructure/nzbget/SERVER3_NAME }}
Server3.Host={{ op://Infrastructure/nzbget/SERVER3_HOST }}
Server3.Port=563
Server3.Encryption=yes
Server3.Connections=50
Server3.Username={{ op://Infrastructure/nzbget/SERVER3_USER }}
Server3.Password={{ op://Infrastructure/nzbget/SERVER3_PASS }}
Server3.Level=0
Server3.Group=2
Server3.Cipher=TLS_AES_128_GCM_SHA256

# Server 4 (block/fill)
Server4.Active=yes
Server4.Name={{ op://Infrastructure/nzbget/SERVER4_NAME }}
Server4.Host={{ op://Infrastructure/nzbget/SERVER4_HOST }}
Server4.Port=563
Server4.Encryption=yes
Server4.Connections=10
Server4.Username={{ op://Infrastructure/nzbget/SERVER4_USER }}
Server4.Password={{ op://Infrastructure/nzbget/SERVER4_PASS }}
Server4.Level=1
Server4.Group=0
Server4.Cipher=TLS_AES_128_GCM_SHA256

# Categories
Category1.Name=movies
Category1.DestDir=
Category1.Aliases=movies*

Category2.Name=series
Category2.DestDir=
Category2.Aliases=tv*

Category3.Name=music
Category3.DestDir=
Category3.Aliases=music*

Category4.Name=software
Category4.DestDir=
Category4.Aliases=software*

Category5.Name=books
Category5.DestDir=
Category5.Aliases=books*, ebooks*

Category6.Name=audiobooks
Category6.DestDir=
Category6.Aliases=audiobooks*
