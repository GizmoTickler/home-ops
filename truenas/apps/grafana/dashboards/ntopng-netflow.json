        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-nflo0"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT multiIf( INPUT_SNMP = 87, 'Vlan3044 (Frontier WAN)', INPUT_SNMP = 38, 'Te1/1/2 (Route10 Cellular)', INPUT_SNMP = 31, 'Te1/0/23 (UXG LAN)', INPUT_SNMP = 64, 'Vlan2609 (Trusted)', INPUT_SNMP = 61, 'Vlan20 (IoT)', INPUT_SNMP = 62, 'Vlan550 (Cameras)', INPUT_SNMP = 81, 'Vlan700 (Guest)', INPUT_SNMP = 55, 'Vlan999 (MGMT)', INPUT_SNMP = 58, 'Po10 (nas01)', INPUT_SNMP = 59, 'Po20 (pve)', concat('ifIndex-', toString(INPUT_SNMP)) ) AS interface, sum(TOTAL_BYTES) AS bytes, count() AS flows FROM ntopng.flows WHERE $__timeFilter(FIRST_SEEN) AND INTERFACE_ID = 1 GROUP BY interface ORDER BY bytes DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "SC01 IPFIX Volume by Ingress Interface (ClickHouse)",
      "type": "table"
