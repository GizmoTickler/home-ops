# VictoriaMetrics scrape config (truenas/apps/victoria-metrics). Rendered by the reconciler (domain via 1Password).
# Ported 1:1 from the k8s vmagent's static/probe jobs (same job names, so dashboards/rules/kromgo keep matching);
# in-cluster blackbox-exporter -> nas01 blackbox-exporter. k8s service/pod/node scrapes are gone with the cluster.
# Added for nas01: the monitoring apps themselves, Envoy, kromgo, a probe of Envoy's wildcard cert.
# VictoriaMetrics re-reads this file every 30 s (-promscrape.configCheckInterval); no restart needed.
global:
  scrape_interval: 30s
  scrape_timeout: 15s
  external_labels:
    prometheus: observability/stack
scrape_configs:
- job_name: probe/observability/devices
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - icmp
  static_configs:
  - targets:
    - sc01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - nas01-console.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - unifi.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - jellyfin.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - s3.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - edge0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - edge1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - dns0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - dns1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - 10.255.255.46
    - gateway1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - mgateway1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - cell-gateway0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - cell-gateway1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
- job_name: probe/observability/dns
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - tcp_connect
  static_configs:
  - targets:
    - 192.168.123.250:53
    - 192.168.123.251:53
    - 10.53.53.53:53
  relabel_configs:
  - source_labels:
