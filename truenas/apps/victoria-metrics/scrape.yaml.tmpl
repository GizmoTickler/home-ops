# VictoriaMetrics scrape config (truenas/apps/victoria-metrics). Rendered by the reconciler (domain via 1Password).
# Ported 1:1 from the k8s vmagent's static/probe jobs (same job names, so dashboards/rules/kromgo keep matching);
# in-cluster blackbox-exporter -> nas01 blackbox-exporter. k8s service/pod/node scrapes are gone with the cluster.
# Added for nas01: the monitoring apps themselves, Envoy, kromgo, a probe of Envoy's wildcard cert.
# VictoriaMetrics re-reads this file every 30 s (-promscrape.configCheckInterval); no restart needed.
global:
  scrape_interval: 30s
  scrape_timeout: 15s
  external_labels:
    prometheus: observability/stack
scrape_configs:
- job_name: probe/observability/devices
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - icmp
  static_configs:
  - targets:
    - sc01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - nas01-console.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - pve.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - pve-console.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - unifi.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - alta-control.management.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - aap-0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - omarchy0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - omarchy1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - jellyfin.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - s3.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - edge0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - edge1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - zonecore-0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - zonecore-1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
    - 192.168.120.243
    - 10.255.255.46
    - 10.255.255.50
    - mgateway1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
- job_name: probe/observability/dns
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - dns_soa       # a real UDP SOA query through ZoneCore authoritative + anycast
  static_configs:
  - targets:
    - 192.168.120.240:53   # zonecore-0
    - 192.168.120.241:53   # zonecore-1
    - 10.53.53.53:53       # anycast primary (zonecore-0)
    - 10.53.53.54:53       # anycast secondary (zonecore-1)
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
- job_name: probe/observability/dns-tcp
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - dns_soa_tcp   # TCP :53 SOA query through ZoneCore authoritative + anycast
  static_configs:
  - targets:
    - 192.168.120.240:53   # zonecore-0
    - 192.168.120.241:53   # zonecore-1
    - 10.53.53.53:53       # anycast primary (zonecore-0)
    - 10.53.53.54:53       # anycast secondary (zonecore-1)
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
# Note: blackbox-exporter v0.29.1 does not implement QUIC (DoQ UDP/853) or NTPv4 (UDP/123) probers.
# Active RFC 9250 DoQ (:853) and RFC 5905 NTPv4 (:123) probing runs via the `zonecore-prober` sidecar
# (zonecore-prober:9116 on `monitoring` net, NATing via nas01 SGT 15). Enable probe/observability/nts-ke
# (module: nts_ke_tls, TCP/4460) once ZoneCore enables nts_server_enabled=true and TrustSec permits it.
- job_name: probe/observability/dns-dot
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - dns_dot
  static_configs:
  - targets:
    - 192.168.120.240:853   # zonecore-0
    - 192.168.120.241:853   # zonecore-1
    - 10.53.53.53:853       # anycast primary
    - 10.53.53.54:853       # anycast secondary
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
- job_name: probe/observability/dns-doq
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - dns_doq               # RFC 9250 DoQ (QUICv1 + TLS 1.3 + ALPN doq) SOA query
  static_configs:
  - targets:
    - 192.168.120.240:853   # zonecore-0
    - 192.168.120.241:853   # zonecore-1
    - 10.53.53.53:853       # anycast primary
    - 10.53.53.54:853       # anycast secondary
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: zonecore-prober:9116
- job_name: probe/observability/ntp
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - ntp                   # RFC 5905 NTPv4 Mode-3 -> synced Mode-4 UDP/123 probe
  static_configs:
  - targets:
    - 10.123.123.123:123    # clock0 anycast (zonecore-0)
    - 10.123.123.124:123    # clock1 anycast (zonecore-1)
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: zonecore-prober:9116
- job_name: probe/observability/dns-doh
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - dns_doh
  static_configs:
  - targets:
    - https://dns.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/dns-query?dns=AAABAAABAAAAAAAACWxvY2FsaG9zdAAAAQAB
    - https://zonecore-0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/dns-query?dns=AAABAAABAAAAAAAACWxvY2FsaG9zdAAAAQAB
    - https://zonecore-1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/dns-query?dns=AAABAAABAAAAAAAACWxvY2FsaG9zdAAAAQAB
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    regex: "([^?]+).*"
    target_label: instance
    replacement: "$1"
  - target_label: __address__
    replacement: blackbox-exporter:9115
- job_name: route10-cellular
  scrape_timeout: 10s
  static_configs:
  - targets:
    - 10.255.255.50:9100
    labels:
      device: route10
- job_name: mgateway1
  scrape_interval: 30s
  scrape_timeout: 10s
  scheme: https
  metrics_path: /api/v1/metrics
  bearer_token_file: /etc/vm/mgateway1.token
  static_configs:
  - targets:
    - mgateway1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:443
    labels:
      device: mgateway1
# ZoneCore DDI/NTP/BGP/HA appliances (replaced legacy dns-0/dns-1 Knot+Unbound+dnsdist+Kea on 2026-11-23).
- job_name: zonecore-0
  scrape_interval: 30s
  scrape_timeout: 10s
  scheme: https
  metrics_path: /api/v1/metrics
  bearer_token_file: /etc/vm/zonecore-0.token
  tls_config:
    insecure_skip_verify: true
  static_configs:
  - targets:
    - zonecore-0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:443
    labels:
      node: zonecore-0
  relabel_configs:
  - target_label: job
    replacement: zonecore
- job_name: zonecore-1
  scrape_interval: 30s
  scrape_timeout: 10s
  scheme: https
  metrics_path: /api/v1/metrics
  bearer_token_file: /etc/vm/zonecore-1.token
  tls_config:
    insecure_skip_verify: true
  static_configs:
  - targets:
    - zonecore-1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:443
    labels:
      node: zonecore-1
  relabel_configs:
  - target_label: job
    replacement: zonecore
- job_name: staticScrape/observability/nas-node-exporter/0
  static_configs:
  - targets:
    - nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9100
    labels:
      job: node-exporter
  honor_labels: false
  scrape_timeout: 10s
  relabel_configs:
  - target_label: job
    replacement: node-exporter
- job_name: staticScrape/observability/nas-smartctl-exporter/0
  static_configs:
  - targets:
    - nas01.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9633
    labels:
      job: smartctl-exporter
  honor_labels: false
  # 25s, not 10s: when the exporter's 60s cache expires the scrape waits for smartctl on all 45 disks (3-12 s),
  # so a 10s timeout dropped ~1 scrape in 5 (up flapping to 0).
  scrape_timeout: 25s
  relabel_configs:
  - target_label: job
    replacement: smartctl-exporter
- job_name: probe/observability/internet
  honor_labels: false
  metrics_path: /probe
  params:
    module:
    - icmp
  static_configs:
  - targets:
    - 1.1.1.1
    - 8.8.8.8
    - 9.9.9.9
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
# Primary-WAN (UXG-Fiber) latency/reachability from nas01's own blackbox-exporter; kept separate from
# probe/observability/internet so WAN RTT dashboards keep matching job="wan-icmp-rtt".
- job_name: wan-icmp-rtt
  honor_labels: false
  scrape_interval: 30s
  scrape_timeout: 10s
  metrics_path: /probe
  params:
    module:
    - icmp
  static_configs:
  - targets:
    - 1.1.1.1
    - 8.8.8.8
    - 9.9.9.9
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
- job_name: staticScrape/observability/onepassword-connect/0
  static_configs:
  - targets:
    - passwords.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:443
    labels:
      job: onepassword-connect
  honor_labels: false
  scrape_timeout: 10s
  scheme: https
  relabel_configs:
  - target_label: job
    replacement: onepassword-connect
  tls_config:
    insecure_skip_verify: true
- job_name: staticScrape/observability/rhel-node-exporter/0
  static_configs:
  - targets:
    - aap-0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9100
    - unifi-0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9100
    - omarchy0.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9100
    - omarchy1.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9100
    - netflow.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9100
    labels:
      job: node-exporter
  honor_labels: false
  scrape_timeout: 10s
  relabel_configs:
  - target_label: job
    replacement: node-exporter
- job_name: staticScrape/observability/snmp-cisco/0
  static_configs:
  - targets:
    - 10.255.255.253
    labels:
      job: snmp
  honor_labels: false
  scrape_interval: 60s
  scrape_timeout: 30s
  metrics_path: /snmp
  params:
    auth:
    - ntopng_v3
    module:
    - if_mib
    - cisco_health
    - bgp
  relabel_configs:
  - target_label: job
    replacement: snmp-cisco
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: netflow.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}:9116
- job_name: vmsingle-stack
  static_configs:
  - targets:
    - 127.0.0.1:8428
- job_name: vmalert-stack
  static_configs:
  - targets:
    - vmalert:8880
- job_name: vmalertmanager-stack
  static_configs:
  - targets:
    - alertmanager:9093
- job_name: grafana
  static_configs:
  - targets:
    - grafana:3000
- job_name: gatus
  static_configs:
  - targets:
    - gatus:80
- job_name: blackbox-exporter
  static_configs:
  - targets:
    - blackbox-exporter:9115
- job_name: envoy
  static_configs:
  - targets:
    - envoy:9180
# cloudflared is not on the monitoring network (internet-facing, by design): Envoy proxies its :2000/metrics on the
# monitoring-only listener envoy:9180 at /cloudflared/metrics.
- job_name: cloudflared
  metrics_path: /cloudflared/metrics
  static_configs:
  - targets:
    - envoy:9180
  relabel_configs:
  - target_label: instance
    replacement: cloudflared
# autobrr stays off `monitoring`: Envoy proxies its :9094/metrics on envoy:9180 at /autobrr/metrics.
- job_name: autobrr
  metrics_path: /autobrr/metrics
  static_configs:
  - targets:
    - envoy:9180
  relabel_configs:
  - target_label: instance
    replacement: autobrr
- job_name: cadvisor
  scrape_interval: 30s
  static_configs:
  - targets:
    - cadvisor:8080
  relabel_configs:
  - target_label: instance
    replacement: nas01
- job_name: kromgo
  static_configs:
  - targets:
    - kromgo:8080
- job_name: probe/nas01/envoy-cert
  metrics_path: /probe
  params:
    module:
    - http_2xx
  static_configs:
  - targets:
    - https://envoy-test.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}/
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox-exporter:9115
- job_name: unifi
  scrape_interval: 30s
  scrape_timeout: 15s
  static_configs:
  - targets:
    - unifi-exporter:9130
  relabel_configs:
  - target_label: instance
    replacement: unifi0
