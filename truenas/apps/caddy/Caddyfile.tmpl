# Caddyfile for the nas01 ingress (truenas/apps/caddy). Rendered by the reconciler; a change restarts Caddy.
# No secrets or domain here: {$DOMAIN}, {$CF_API_TOKEN}, {$EAB_*} come from the container env (1Password refs).
#
# Layout:
#   internal site  *.{$DOMAIN}       LAN 192.168.123.156:443 + apps network 172.31.200.2:443
#   external site  *.{$DOMAIN}:8443  bound to 172.31.200.2 only; reached solely by cloudflared (Cloudflare tunnel)
# A migrated app gets one `@name host ...` + `handle @name { ... }` block; anything not handled yet falls through
# to the k8s gateways, so a hostname can be pointed at Caddy before (or without) its app moving.
# Pocket ID forward-auth: `import pocket_id <app>-auth <upstream>` -- the app's compose runs an oauth2-proxy
# (`<app>-auth`) with the app's existing Pocket ID client (same client id/secret/redirect URI as on k8s).

{
	email {$ACME_EMAIL}
	# GTS first (EAB), Let's Encrypt as fallback. No propagation check (it timed out from nas01: direct queries to the
	# authoritative servers do not get through); a fixed 45 s delay is ample for Cloudflare.
	cert_issuer acme https://dv.acme-v02.api.pki.goog/directory {
		eab {$EAB_KEY_ID} {$EAB_HMAC_KEY}
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
		propagation_delay 45s
		propagation_timeout -1
	}
	cert_issuer acme https://acme-v02.api.letsencrypt.org/directory {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
		propagation_delay 45s
		propagation_timeout -1
	}
	admin localhost:2019
	metrics
	servers {
		trusted_proxies static private_ranges
	}
}

# ---- snippets ---------------------------------------------------------------------------------------------
(k8s_internal) {
	reverse_proxy https://192.168.255.11 {
		header_up Host {host}
		transport http {
			tls_server_name {host}
		}
	}
}

(k8s_external) {
	reverse_proxy https://192.168.255.12 {
		header_up Host {host}
		transport http {
			tls_server_name {host}
		}
	}
}

# args: <oauth2-proxy service> <upstream host:port>
(pocket_id) {
	handle /oauth2/* {
		reverse_proxy {args[0]}:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}
	handle {
		forward_auth {args[0]}:4180 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Preferred-Username
			@unauth status 401
			handle_response @unauth {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		reverse_proxy {args[1]}
	}
}

# ---- metrics (monitoring network only) --------------------------------------------------------------------------
http://:9180 {
	bind 172.31.201.254
	metrics /metrics
}

# ---- internal ---------------------------------------------------------------------------------------------
*.{$DOMAIN}, {$DOMAIN} {
	@caddy-test host caddy-test.{$DOMAIN}
	handle @caddy-test {
		respond "caddy on nas01: ok" 200
	}

	# ==== migrated apps (keep alphabetical) ====
	@actual host actual.{$DOMAIN}
	handle @actual {
		reverse_proxy actual:5006
	}

	@atuin host atuin.{$DOMAIN} sh.{$DOMAIN}
	handle @atuin {
		reverse_proxy atuin:80
	}

	@audiobookshelf host audiobookshelf.{$DOMAIN}
	handle @audiobookshelf {
		reverse_proxy audiobookshelf:80
	}

	@autobrr host autobrr.{$DOMAIN}
	handle @autobrr {
		reverse_proxy autobrr:80
	}

	@bazarr host bazarr.{$DOMAIN}
	handle @bazarr {
		import pocket_id bazarr-auth bazarr:6767
	}

	@chaptarr host chaptarr.{$DOMAIN}
	handle @chaptarr {
		import pocket_id chaptarr-auth chaptarr:80
	}

	@grimmory host grimmory.{$DOMAIN}
	handle @grimmory {
		reverse_proxy grimmory:6060
	}

	@home-assistant host home-assistant.{$DOMAIN} homeassistant.{$DOMAIN}
	handle @home-assistant {
		reverse_proxy home-assistant:8123
	}

	@id host id.{$DOMAIN}
	handle @id {
		reverse_proxy pocket-id:1411
	}

	@it-tools host it-tools.{$DOMAIN}
	handle @it-tools {
		import pocket_id it-tools-auth it-tools:8080
	}

	@n8n host n8n.{$DOMAIN}
	handle @n8n {
		reverse_proxy n8n:8080
	}

	@nzbget host nzbget.{$DOMAIN}
	handle @nzbget {
		import pocket_id nzbget-auth nzbget:6789
	}

	@pinchflat host pinchflat.{$DOMAIN}
	handle @pinchflat {
		import pocket_id pinchflat-auth pinchflat:80
	}

	@prowlarr host prowlarr.{$DOMAIN}
	handle @prowlarr {
		import pocket_id prowlarr-auth prowlarr:80
	}

	@qbittorrent host qbittorrent.{$DOMAIN}
	handle @qbittorrent {
		import pocket_id qbittorrent-auth qbittorrent:8080
	}

	@qui host qui.{$DOMAIN}
	handle @qui {
		reverse_proxy qui:80
	}

	@radarr host radarr.{$DOMAIN}
	handle @radarr {
		import pocket_id radarr-auth radarr:80
	}

	@requests host requests.{$DOMAIN}
	handle @requests {
		import pocket_id seerr-auth seerr:80
	}

	@rss host rss.{$DOMAIN}
	handle @rss {
		reverse_proxy freshrss:8080 {
			header_up X-Forwarded-Port 443
		}
	}

	@sonarr host sonarr.{$DOMAIN}
	handle @sonarr {
		import pocket_id sonarr-auth sonarr:80
	}

	@webhook host webhook.{$DOMAIN}
	handle @webhook {
		@ntopng_other {
			path /hooks/ntopng-alertmanager
			not remote_ip 192.168.120.9
		}
		respond @ntopng_other 403
		reverse_proxy webhook:80
	}

	# ==== monitoring ====
	@alertmanager host alertmanager.{$DOMAIN}
	handle @alertmanager {
		import pocket_id alertmanager-auth alertmanager:9093
	}

	@grafana host grafana.{$DOMAIN}
	handle @grafana {
		reverse_proxy grafana:3000
	}

	@kromgo host kromgo.{$DOMAIN}
	handle @kromgo {
		reverse_proxy kromgo:80
	}

	@metrics host metrics.{$DOMAIN}
	handle @metrics {
		# read-only through the ingress: no ingestion, deletion, snapshot or admin endpoints
		@vm_write path /api/v1/admin/* /api/v1/import* /api/v1/write /api/v1/delete_series /prometheus/api/v1/admin/* /prometheus/api/v1/import* /prometheus/api/v1/write /prometheus/api/v1/delete_series /write /influx/* /datadog/* /opentelemetry/* /newrelic/* /snapshot/* /internal/*
		handle @vm_write {
			respond 403
		}
		handle {
			import pocket_id victoria-metrics-auth victoria-metrics:8428
		}
	}

	@status host status.{$DOMAIN}
	handle @status {
		reverse_proxy gatus:80
	}

	handle {
		import k8s_internal
	}
}

# ---- external (Cloudflare tunnel) -------------------------------------------------------------------------
https://*.{$DOMAIN}:8443, https://{$DOMAIN}:8443 {
	bind 172.31.200.2

	# ==== migrated external hostnames ====
	@n8n-webhook host n8n-webhook.{$DOMAIN}
	handle @n8n-webhook {
		@n8n_public path /webhook /webhook/* /form /form/*
		handle @n8n_public {
			reverse_proxy n8n:8080
		}
		respond 404
	}

	# ==== monitoring ====
	@kromgo-ext host kromgo.{$DOMAIN}
	handle @kromgo-ext {
		reverse_proxy kromgo:80
	}

	handle {
		import k8s_external
	}
}
