#!/bin/sh
set -eu

# Envoy's watched_directory reloads on a *move* into the directory, but lego writes files in place.
# `acme-renew.sh --swap` (also lego's deploy hook) re-publishes the cert/key via copy + rename.
if [ "${1:-}" = "--swap" ]; then
  d=/certs/certificates
  for f in "$d/${DOMAIN}.crt" "$d/${DOMAIN}.key"; do
    cp -p "$f" "$f.swap" && mv -f "$f.swap" "$f"
  done
  echo "$(date -Iseconds) cert re-published for Envoy reload" >&2
  exit 0
fi

# $1 = gts|le, remaining args passed through (e.g. --renew-force).
run_lego() {
  ca=$1; shift
  if [ "$ca" = gts ]; then
    set -- --server googletrust --eab "$@"
  else
    set -- --server letsencrypt "$@"
  fi
  /lego run "$@" \
    --accept-tos \
    --email "$ACME_EMAIL" \
    --path /certs \
    --dns cloudflare \
    --dns.resolvers 192.168.123.250:53 \
    --dns.propagation.wait 90s \
    --domains "$DOMAIN" \
    --domains "*.$DOMAIN" \
    --cert.name "$DOMAIN" \
    --key-type EC256 \
    --renew-days 30 \
    --deploy-hook "/bin/sh /etc/envoy/acme-renew.sh --swap"
}

# Google Trust Services first, Let's Encrypt only if GTS fails.
issue() {
  if run_lego gts "$@"; then
    touch /certs/.ca-gts
  else
    echo "$(date -Iseconds) GTS issuance failed; falling back to Let's Encrypt" >&2
    run_lego le "$@"
  fi
}

if [ ! -f "/certs/certificates/${DOMAIN}.crt" ] || [ ! -f "/certs/certificates/${DOMAIN}.key" ]; then
  issue
elif [ ! -f /certs/.ca-gts ]; then
  # One-time move of an existing (Let's Encrypt) certificate to GTS.
  issue --renew-force || echo "$(date -Iseconds) one-time GTS switch failed; keeping current cert, retry in 12h" >&2
fi

while :; do
  sleep 43200 &
  wait $!
  issue || echo "$(date -Iseconds) lego renew failed; retrying in 12h" >&2
done
