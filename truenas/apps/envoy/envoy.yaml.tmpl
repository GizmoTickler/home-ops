  - name: https_external
    address:
      socket_address:
        address: 172.31.200.254
        port_value: 8443
    filter_chains:
    - transport_socket: *id001
      filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: https_external
          use_remote_address: true
          upgrade_configs:
          - upgrade_type: websocket
          stream_idle_timeout: 3600s
          normalize_path: true
          merge_slashes: true
          common_http_protocol_options:
            idle_timeout: 3600s
          early_header_mutation_extensions: *id002
          route_config:
            name: external_routes
            virtual_hosts:
            - name: gitops_webhook_external
              domains:
              - gitops-webhook.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              routes:
              - match:
                  path: /hooks/truenas-gitops
                  headers:
                  - name: ':method'
                    string_match:
                      exact: POST
                  - name: x-hub-signature-256
                    string_match:
                      prefix: sha256=
                  - name: x-github-event
                    string_match:
                      safe_regex:
                        regex: ^(ping|push|check_run)$
                route:
                  cluster: webhook
                  timeout: 10s
              - match:
                  prefix: /
                direct_response:
                  status: 404
            - name: n8n_webhook_external
              domains:
              - n8n-webhook.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              routes:
              - match:
                  path_separated_prefix: /webhook
                route:
                  cluster: n8n
                  timeout: 0s
              - match:
                  path_separated_prefix: /form
                route:
                  cluster: n8n
                  timeout: 0s
              - match:
                  prefix: /
                direct_response:
                  status: 404
            - name: kromgo_external
              domains:
              - kromgo.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              routes:
              - match:
                  prefix: /
                route:
                  cluster: kromgo
                  timeout: 0s
            - name: k8s_external_fallback
              domains:
              - '*'
              routes:
              - match:
                  prefix: /
                route:
                  cluster: k8s_external
                  timeout: 0s
          http_filters:
          - name: envoy.filters.http.router
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  - name: metrics
    address:
      socket_address:
        address: 172.31.201.254
        port_value: 9180
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: metrics
          route_config:
            name: metrics_routes
            virtual_hosts:
            - name: metrics
              domains:
              - '*'
              routes:
              - match:
                  path: /metrics
                route:
                  cluster: envoy_admin
                  prefix_rewrite: /stats/prometheus
              # cloudflared stays off the monitoring network (internet-facing); VictoriaMetrics scrapes its
              # :2000/metrics through here (job cloudflared). This listener is bound to 172.31.201.254 (monitoring
              # network only): not reachable from `apps`, the LAN or the tunnel, whose listeners have no such route.
              - match:
                  path: /cloudflared/metrics
                route:
                  cluster: cloudflared_metrics
                  prefix_rewrite: /metrics
                  timeout: 10s
              - match:
                  prefix: /
                direct_response:
                  status: 404
          http_filters:
          - name: envoy.filters.http.router
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  - name: alertmanager_ingest
    address:
      socket_address:
        address: 172.31.200.254
        port_value: 9093
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: alertmanager_ingest
          normalize_path: true
          route_config:
            name: alertmanager_ingest
            virtual_hosts:
            - name: alertmanager_ingest
              domains:
              - '*'
              routes:
              - match:
                  path: /api/v2/alerts
                  headers:
                  - name: :method
                    string_match:
                      exact: POST
                route:
                  cluster: alertmanager
                  timeout: 10s
              - match:
                  prefix: /
                direct_response:
                  status: 404
          http_filters:
          - name: envoy.filters.http.rbac
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
              rules:
                action: ALLOW
                policies:
                  webhook:
                    permissions:
                    - any: true
                    principals:
                    - direct_remote_ip:
                        address_prefix: 172.31.200.253
                        prefix_len: 32
          - name: envoy.filters.http.router
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
