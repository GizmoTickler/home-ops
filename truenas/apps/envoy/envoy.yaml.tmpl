# Envoy static configuration for nas01 ingress (truenas/apps/envoy).
# Rendered by truenas/reconciler with 1Password Connect secrets (never logged).
# Protected apps use Envoy's native envoy.extensions.filters.http.oauth2.v3.OAuth2 filter with Pocket ID.
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 9901
static_resources:
  secrets:
  - name: oauth2_hmac
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/oauth2-proxy-cookie-secret/password }}'
  - name: oidc_bazarr
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/bazarr/OIDC_CLIENT_SECRET }}'
  - name: oidc_chaptarr
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/chaptarr/OIDC_CLIENT_SECRET }}'
  - name: oidc_it_tools
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/it-tools/OIDC_CLIENT_SECRET }}'
  - name: oidc_nzbget
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/nzbget/OIDC_CLIENT_SECRET }}'
  - name: oidc_pinchflat
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/pinchflat/OIDC_CLIENT_SECRET }}'
  - name: oidc_prowlarr
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/prowlarr/OIDC_CLIENT_SECRET }}'
  - name: oidc_qbittorrent
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/qbittorrent/OIDC_CLIENT_SECRET }}'
  - name: oidc_radarr
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/radarr/OIDC_CLIENT_SECRET }}'
  - name: oidc_seerr
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/seerr/OIDC_CLIENT_SECRET }}'
  - name: oidc_sonarr
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/sonarr/OIDC_CLIENT_SECRET }}'
  - name: oidc_vmauth
    generic_secret:
      secret:
        inline_string: '{{ op://Infrastructure/vmauth/OIDC_CLIENT_SECRET }}'
  listeners:
  - name: http_redirect
    address:
      socket_address:
        address: 0.0.0.0
        port_value: 80
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: http_80
          route_config:
            name: http_redirect
            virtual_hosts:
            - name: redirect_all
              domains:
              - '*'
              routes:
              - match:
                  prefix: /
                redirect:
                  https_redirect: true
          http_filters:
          - name: envoy.filters.http.router
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  - name: https_internal
    address:
      socket_address:
        address: 0.0.0.0
        port_value: 443
    filter_chains:
    - transport_socket: &id001
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
          common_tls_context:
            alpn_protocols:
            - h2
            - http/1.1
            tls_certificates:
            - certificate_chain:
                filename: /certs/certificates/{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}.crt
              private_key:
                filename: /certs/certificates/{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}.key
              watched_directory:
                path: /certs/certificates
      filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: https_internal
          use_remote_address: true
          upgrade_configs:
          - upgrade_type: websocket
          stream_idle_timeout: 3600s
          normalize_path: true
          merge_slashes: true
          common_http_protocol_options:
            idle_timeout: 3600s
          early_header_mutation_extensions: &id002
          - name: envoy.http.early_header_mutation.header_mutation
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.http.early_header_mutation.header_mutation.v3.HeaderMutation
              mutations:
              - append:
                  header:
                    key: X-Forwarded-Proto
                    value: https
                  append_action: OVERWRITE_IF_EXISTS_OR_ADD
              - append:
                  header:
                    key: X-Real-IP
                    value: '%DOWNSTREAM_REMOTE_ADDRESS_WITHOUT_PORT%'
                  append_action: OVERWRITE_IF_EXISTS_OR_ADD
          route_config:
            name: internal_routes
            virtual_hosts:
            - name: envoy_test
              domains:
              - envoy-test.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              - caddy-test.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              routes:
              - match:
                  prefix: /
                direct_response:
                  status: 200
                  body:
                    inline_string: 'envoy on nas01: ok'
            - name: actual
              domains:
              - actual.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              response_headers_to_add:
              - header:
                  key: Cross-Origin-Opener-Policy
                  value: same-origin
                append_action: OVERWRITE_IF_EXISTS_OR_ADD
              - header:
                  key: Cross-Origin-Embedder-Policy
                  value: require-corp
                append_action: OVERWRITE_IF_EXISTS_OR_ADD
              routes:
              - match:
                  prefix: /
                route:
                  cluster: actual
                  timeout: 0s
            - name: alertmanager
              domains:
              - alertmanager.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              routes:
              - match:
                  prefix: /
                route:
                  cluster: alertmanager
                  timeout: 0s
                typed_per_filter_config:
                  envoy.filters.http.oauth2/alertmanager:
                    '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                    config: {}
            - name: atuin
              domains:
              - atuin.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              - sh.{{ op://Infrastructure/cluster-config/SECRET_DOMAIN }}
              routes:
              - match:
                  prefix: /
                route:
                  cluster: atuin
                  timeout: 0s
            - name: audiobookshelf
